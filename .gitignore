# Python (anchored to repo root so frontend/dist is not caught)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/build/
/dist/
.venv/
.venv-app/            # created by the double-click launchers
venv/
env/

# Testing / tooling
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS
.DS_Store
Thumbs.db

# Vowelchemy working output (alignments, extracted formants, exports)
# These are generated per-corpus and should not be committed.
*_vowelchemy_out/
scratch/
*.TextGrid.tmp

# But keep the bundled demo dataset
!vowelchemy/data/

# Frontend (React/Vite) — deps are regenerated. The production build goes to
# vowelchemy/webui/ (committed + shipped in the wheel, so `pip install .` then
# `vowelchemy app` works without Node). frontend/dist is a stale location.
frontend/node_modules/
frontend/dist/
frontend/*.tsbuildinfo
